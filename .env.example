# ============================================================
# Frontend environment variables
# Copy this file to .env and fill in the values.
# ============================================================

# CI3 Backend API base URL (no trailing slash)
# Local dev:        http://localhost/api-backend/api/v1
# Shared hosting:   https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://api.soinfan.com.ng/api/v1
# Brand / white-label selection.
# Must match a key registered in src/config/brands/index.ts
# To add a new brand:
#   1. Create  src/config/brands/mybrand.ts  (copy gigadata.ts as template)
#   2. Add it to the brandMap in  src/config/brands/index.ts
#   3. Drop logo assets in  public/brands/mybrand/
#   4. Set VITE_BRAND=mybrand here and rebuild
VITE_BRAND=gigadata

